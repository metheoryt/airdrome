{
  "mcpServers": {
    "gortex": {
      "command": "gortex",
      "args": [
        "mcp"
      ],
      "env": {
        "GORTEX_INDEX_WORKERS": "${GORTEX_WORKERS:-8}"
      }
    },
    "postgres": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--with",
        "mcp<2",
        "postgres-mcp",
        "--access-mode=restricted"
      ],
      "env": {
        "DATABASE_URI": "postgresql://postgres:postgres@localhost:5437/postgres"
      }
    }
  }
}
